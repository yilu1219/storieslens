OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_API_URL=https://openrouter.ai/api/v1/images
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_API_URL=https://openrouter.ai/api/v1/videos
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0-fast
IMAGE_PROVIDER=OPENROUTER
IMAGE_ASPECT_RATIO=16:9
IMAGE_SIZE=2560x1440
IMAGE_RESOLUTION=
VIDEO_DURATION=5
VIDEO_ASPECT_RATIO=16:9
VIDEO_RESOLUTION=720p
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_TITLE=StoriesLens

# Strict content safety. Media generation fails closed when external moderation
# is unavailable. Use a server-side key; never expose it in browser JavaScript.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
REQUIRE_EXTERNAL_TEXT_MODERATION=true
REQUIRE_EXTERNAL_MEDIA_MODERATION=true
SAFE_VIDEO_GENERATION_ENABLED=false

# Stripe Payment Links. Create each product in Stripe, then paste its
# https://buy.stripe.com/... URL here. Leave blank to keep checkout disabled.
STRIPE_STORY_PASS_URL=
STRIPE_GUIDED_SQUAD_URL=
STRIPE_MOVIE_30_URL=
STRIPE_MOVIE_60_URL=
