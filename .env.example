OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_API_URL=https://openrouter.ai/api/v1/images
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_VIDEO_API_URL=https://openrouter.ai/api/v1/videos
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0-fast
IMAGE_PROVIDER=OPENROUTER
IMAGE_ASPECT_RATIO=16:9
IMAGE_SIZE=2560x1440
IMAGE_RESOLUTION=
VIDEO_DURATION=5
VIDEO_ASPECT_RATIO=16:9
VIDEO_RESOLUTION=720p
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_TITLE=StoriesLens

# Mainland China text route. Accounts that select China Mainland never fall
# back to OpenRouter when these fields are absent; the request fails closed.
# Create a dedicated Ark inference endpoint and API key in the China account.
CHINA_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CHINA_ARK_API_KEY=
CHINA_ARK_TEXT_MODEL=
CHINA_ARK_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
CHINA_ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
CHINA_ARK_IMAGE_SIZE=2K
CHINA_ARK_IMAGE_COST_CNY=0.22
CHINA_CNY_PER_USD=7.2
# Image/video must use the China provider's official async APIs. Keep these
# empty until their endpoint-specific adapter and content-governance review pass.
CHINA_ARK_IMAGE_ENABLED=false
CHINA_ARK_VIDEO_ENABLED=false

# Strict content safety. Media generation fails closed when external moderation
# is unavailable. Use a server-side key; never expose it in browser JavaScript.
OPENAI_MODERATION_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_API_KEY=
OPENAI_ARTWORK_REVIEW_MODEL=gpt-4o-mini
OPENROUTER_SAFETY_MODEL=openai/gpt-4o-mini
OPENROUTER_ARTWORK_REVIEW_MODEL=openai/gpt-4o-mini
REQUIRE_EXTERNAL_TEXT_MODERATION=true
REQUIRE_EXTERNAL_MEDIA_MODERATION=true
SAFE_VIDEO_GENERATION_ENABLED=false

# Stripe-hosted Checkout. Start in test mode. The server creates one Checkout
# Session per signed-in adult account and grants allowance only after a signed
# webhook confirms the exact order, amount and package. Never expose either
# secret to browser JavaScript or commit a real value.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_API_BASE_URL=https://api.stripe.com

# Product platform. Email codes are sent through Resend when configured. Verify
# the sending domain first, create a restricted API key, and keep it only in the
# hosting provider's secret environment. AUTH_DELIVERY_WEBHOOK_URL remains an
# optional fallback and is required for SMS delivery. In local development with
# no provider, the verification code is returned to the browser as a test code.
NODE_ENV=development
STORIESLENS_REGION=local
PUBLIC_BASE_URL=https://www.storieslens.com
RESEND_API_KEY=
AUTH_EMAIL_FROM=StoriesLens <login@storieslens.com>
AUTH_EMAIL_REPLY_TO=
AUTH_DELIVERY_WEBHOOK_URL=
AUTH_DELIVERY_WEBHOOK_SECRET=

# Private allowance console and persistent application data. Generate a long
# random admin key, store only its SHA-256 digest here, and never commit the
# real digest or raw key. PLATFORM_DATA_DIR must live on a persistent encrypted
# volume in production; ephemeral hosting will lose users, credits and invites.
ADMIN_ACCESS_KEY_SHA256=
PLATFORM_DATA_DIR=
INVITE_CODE_AUTH_ENABLED=false

# Optional closed-cohort gate. Reward codes are stored only as SHA-256 hashes.
# Generate regional codes with: npm run beta:codes
ENFORCE_LAUNCH_GATES=true
# Public email registration is the default. Set true only for a deliberately
# closed cohort; reward codes remain optional when this is false.
REGISTRATION_INVITE_REQUIRED=false
BETA_INVITE_ONLY=false
BETA_INVITE_CODE_HASHES=
BETA_MAX_ACCOUNTS_PER_CODE=10
BETA_ADULT_ACCOUNT_OWNER_ONLY=true
BETA_RATE_LIMIT_ENABLED=true
RATE_LIMIT_SECRET=
ALLOWED_INTL_COUNTRY_CODES=CA,GB,AU,SG,NZ
PUBLIC_STORY_DISCOVERY_ENABLED=false
REAL_PERSON_PHOTO_UPLOADS_ENABLED=true
REAL_PERSON_PHOTO_REQUIRE_ACCOUNT=true
REQUIRE_PERSONAL_PHOTO_CONSENT=true
USE_CUSTOMER_CONTENT_FOR_TRAINING=false
ACCOUNT_DELETION_ENABLED=true

# Legal approval is a human gate, never an automatic claim. Keep false until a
# qualified reviewer approves the beta notices for the exact launch regions.
LEGAL_REVIEW_APPROVED=false
LEGAL_CONTACT_EMAIL=privacy@storieslens.com
ERROR_REPORTING_WEBHOOK_URL=

# Private regional media storage. Each region falls back to local development
# storage until all four required values (endpoint, bucket, access key, secret)
# are configured. Use private buckets and server-side secrets only.
# In production, list only the regions you are opening to users. The server will
# refuse to start if any listed route is still using local fallback storage.
MEDIA_REQUIRED_REGIONS=cn,us,intl
MEDIA_VOLUME_REGIONS=
# Registration is available only for routes with live private storage. Expand
# this list deliberately as each regional stack passes its launch checklist.
ALLOWED_ACCOUNT_REGIONS=cn,us,intl
# Beta cost guards. Defaults shown here: 20 MB for guests, 250 MB for verified
# accounts. Later paid entitlements can raise the account value server-side.
MEDIA_GUEST_QUOTA_BYTES=20971520
MEDIA_ACCOUNT_QUOTA_BYTES=262144000
# China: Volcano Engine TOS native endpoint. TOS requires virtual-hosted bucket
# URLs, and these protocol settings make the server use native TOS V4 signing.
MEDIA_CN_ENDPOINT=https://tos-cn-beijing.volces.com
MEDIA_CN_BUCKET=storieslens-cn-private-2026
MEDIA_CN_ACCESS_KEY_ID=
MEDIA_CN_SECRET_ACCESS_KEY=
MEDIA_CN_SIGNING_REGION=cn-beijing
MEDIA_CN_PROTOCOL=tos
MEDIA_CN_ADDRESSING_STYLE=virtual
# United States: Cloudflare R2 US-jurisdiction endpoint.
MEDIA_US_ENDPOINT=
MEDIA_US_BUCKET=
MEDIA_US_ACCESS_KEY_ID=
MEDIA_US_SECRET_ACCESS_KEY=
MEDIA_US_SIGNING_REGION=auto
# Other countries/regions: a separate R2 bucket, initially located near the
# launch audience. Keep it separate so it can later be migrated by country.
MEDIA_INTL_ENDPOINT=
MEDIA_INTL_BUCKET=
MEDIA_INTL_ACCESS_KEY_ID=
MEDIA_INTL_SECRET_ACCESS_KEY=
MEDIA_INTL_SIGNING_REGION=auto

# WeChat OAuth remains disabled until a verified WeChat Open Platform app is
# connected. Never put the app secret in browser JavaScript.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Optional web push delivery plus private, non-AI assembly/export binaries.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Usually auto-detected from ffmpeg-static; set only when the host has its own binary.
FFMPEG_BIN=
# Required for one-click PDF export. Word export works without it.
LIBREOFFICE_BIN=
# Optional CJK font name installed on the PDF renderer; Railway installs Noto.
PDF_CJK_FONT=Noto Serif CJK SC
